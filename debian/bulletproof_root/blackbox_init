#!/bin/busybox sh
# M463(魅蓝1) v10.1 黑匣子 — PID 1 全流程
# 架构(两级):
#   第一级: MTK ram_console(内核自带, 0x43F00000) 自动捕获 panic/内核日志, 热复位保留
#   第二级: 本脚本读 /proc/last_kmsg2(上轮遗言) + 本轮诊断 → 写 cache 分区(ext4 文件) → 关机
#   回读: 机主插刷机线 → mtkclient 读 cache → 诊断到手(不需要串口硬件)
# 红线: cache 按 PARTNAME=cache 确认; ext4 挂载优先; 裸写只做兜底且避开分区头部

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null

/bin/busybox mkdir -p /proc /sys /dev /tmp /bb /cache
/bin/busybox mount -t proc proc /proc 2>/dev/null
/bin/busybox mount -t sysfs sysfs /sys 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /dev 2>/dev/null
/bin/busybox mdev -s 2>/dev/null

# ===== 等 eMMC 就绪(最多 20 秒) =====
n=0
while [ $n -lt 20 ] && [ ! -e /sys/block/mmcblk0 ]; do
    sleep 1
    n=$((n+1))
done

# ===== ACM gadget + getty(USB 可枚举时 = 直接一个 root shell) =====
A=/sys/class/android_usb/android0
if [ -d "$A" ]; then
    echo 0 > "$A/enable" 2>/dev/null
    echo 2a45 > "$A/idVendor" 2>/dev/null
    echo 0006 > "$A/idProduct" 2>/dev/null
    echo acm > "$A/functions" 2>/dev/null
    echo 1 > "$A/enable" 2>/dev/null
    for i in 0 1; do
        [ -f "/sys/class/tty/ttyGS$i/dev" ] || continue
        MM=$(cat "/sys/class/tty/ttyGS$i/dev" 2>/dev/null)
        [ -n "$MM" ] && mknod -m 666 "/dev/ttyGS$i" c ${MM%%:*} ${MM##*:} 2>/dev/null
    done
    ( while true; do getty -L 115200 ttyGS0 vt100; sleep 1; done ) 2>/dev/null &
fi

# ===== 按 PARTNAME 找 expdb 分区(MTK 原生异常调试分区, 10MB) =====
CACHEDEV=""
for ue in /sys/class/block/mmcblk0p*/uevent; do
    [ -f "$ue" ] || continue
    grep -q "PARTNAME=expdb" "$ue" 2>/dev/null || continue
    bn=${ue%/uevent}
    bn=${bn##*/}
    MAJ=$(grep -oE "MAJOR=[0-9]+" "$ue" | cut -d= -f2)
    MIN=$(grep -oE "MINOR=[0-9]+" "$ue" | cut -d= -f2)
    if [ -n "$MAJ" ] && [ -n "$MIN" ]; then
        mknod "/dev/$bn" b "$MAJ" "$MIN" 2>/dev/null
        CACHEDEV="/dev/$bn"
    fi
    break
done

# ===== 收集: 上轮遗言(last_kmsg2) + 本轮全诊断 =====
collect() {
    {
        echo "=== M1 BLACKBOX v10.1 ==="
        echo "=== uptime ==="
        cat /proc/uptime 2>/dev/null
        echo "=== cmdline (LK 实传) ==="
        cat /proc/cmdline 2>/dev/null
        echo "=== version (编译器) ==="
        cat /proc/version 2>/dev/null
        echo "=== boot_mode ==="
        cat /sys/class/BOOT/BOOT/boot/boot_mode 2>/dev/null
        echo "=== eMMC CID ==="
        cat /sys/block/mmcblk0/device/cid 2>/dev/null
        echo "=== dmesg (本轮内核日志) ==="
        dmesg 2>/dev/null
        echo "=== last_kmsg2 (上轮遗言) ==="
        cat /proc/last_kmsg2 2>/dev/null
        echo "=== last_kmsg ==="
        cat /proc/last_kmsg 2>/dev/null
        echo "=== partitions ==="
        cat /proc/partitions 2>/dev/null
        echo "=== android_usb ==="
        for f in /sys/class/android_usb/android0/*; do
            echo "$(basename $f)=$(cat $f 2>/dev/null)"
        done
        echo "=== block PARTNAME 全表 ==="
        for f in /sys/class/block/*/uevent; do
            echo "-- ${f##*/}"; cat "$f" 2>/dev/null
        done
        echo "=== END OF BLACKBOX ==="
    } > /bb/all.txt 2>/dev/null
}

collect

# ===== 写入 cache: ext4 挂载写文件(原子改名) 优先, 裸写兜底 =====
WRITTEN=0
if [ -n "$CACHEDEV" ]; then
    if mount -t ext4 "$CACHEDEV" /cache 2>/dev/null; then
        mkdir -p /cache/blackbox 2>/dev/null
        cp /bb/all.txt /cache/blackbox/all.txt 2>/dev/null
        cp /bb/last_kmsg2.txt /cache/blackbox/last_kmsg2.txt 2>/dev/null
        sync 2>/dev/null
        umount /cache 2>/dev/null
        WRITTEN=1
    else
        # 裸写兜底: 写在 offset 8MB 处(避开 ext4 头部元数据)
        dd if=/bb/all.txt of="$CACHEDEV" bs=4096 seek=2048 conv=fsync 2>/dev/null && WRITTEN=1
    fi
fi
echo "BLACKBOX: written=$WRITTEN cache=$CACHEDEV" > /dev/console 2>/dev/null

# ===== 心跳循环: 每 5 秒重新收集+写入(内核若中途挂死, cache 停在最后状态) =====
i=0
while [ $i -lt 12 ]; do
    sleep 5
    collect
    if [ -n "$CACHEDEV" ]; then
        if grep -q "on /cache" /proc/mounts 2>/dev/null; then
            mount -o remount,ro /cache 2>/dev/null
            mount -o remount,rw /cache 2>/dev/null
        else
            mount -t ext4 "$CACHEDEV" /cache 2>/dev/null
        fi
        cp /bb/all.txt /cache/blackbox/all.txt 2>/dev/null
        sync 2>/dev/null
    fi
    i=$((i+1))
done
sync 2>/dev/null
umount /cache 2>/dev/null

# ===== 60 秒后自动关机(reboot(2) 系统调用, 不碰 RGU 寄存器) =====
poweroff -f 2>/dev/null
sleep 10
poweroff -f 2>/dev/null
while true; do sleep 1; done
