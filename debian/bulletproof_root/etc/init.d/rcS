#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null
/bin/busybox --install -s /sbin 2>/dev/null

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s 2>/dev/null

# 1. Visual confirmation: Clear screen to show Linux took over display
for fb in /dev/fb0 /dev/graphics/fb0; do
    if [ -c "$fb" ] || [ -b "$fb" ] || [ -e "$fb" ]; then
        # Fill first 8MB (1080x1920x4 = ~8MB) with solid green/blue pattern or zeroes
        dd if=/dev/zero of="$fb" bs=1M count=8 2>/dev/null
    fi
done

# 2. Configure USB CDC-ACM Serial Console
A=/sys/class/android_usb/android0
if [ -d "$A" ]; then
    echo 0 > "$A/enable" 2>/dev/null
    sleep 0.2
    echo 2a45 > "$A/idVendor" 2>/dev/null
    echo 0006 > "$A/idProduct" 2>/dev/null
    echo 02 > "$A/bDeviceClass" 2>/dev/null
    if [ -d "$A/f_acm" ]; then
        echo 1 > "$A/f_acm/instances" 2>/dev/null
    fi
    echo acm > "$A/functions" 2>/dev/null
    if [ -f /sys/devices/platform/mt_usb/saving ]; then
        echo 1 > /sys/devices/platform/mt_usb/saving 2>/dev/null
    fi
    echo 1 > "$A/enable" 2>/dev/null
fi

# Ensure device nodes for ttyGS0
for i in 0 1 2 3; do
    if [ -f "/sys/class/tty/ttyGS$i/dev" ]; then
        MM=$(cat "/sys/class/tty/ttyGS$i/dev")
        mknod -m 666 "/dev/ttyGS$i" c ${MM%%:*} ${MM##*:} 2>/dev/null
    fi
done

echo "==============================================" > /dev/console 2>/dev/null
echo "   Meizu M463 Debian Linux Rescue Console!     " > /dev/console 2>/dev/null
echo "==============================================" > /dev/console 2>/dev/null

# 3. Mount Debian rootfs if available on userdata partition
for p in /dev/mmcblk0p20 /dev/mmcblk0p* /dev/block/platform/mtk-msdc.0/by-name/userdata; do
    [ -b "$p" ] || continue
    if mount -t ext4 -o ro "$p" /newroot 2>/dev/null; then
        if [ -f /newroot/etc/wbm1-release ] || [ -f /newroot/sbin/init ]; then
            echo "[INIT] Switching root to Debian on $p..." > /dev/console 2>/dev/null
            mount -o remount,rw /newroot 2>/dev/null
            mount --move /proc /newroot/proc 2>/dev/null
            mount --move /sys /newroot/sys 2>/dev/null
            mount --move /dev /newroot/dev 2>/dev/null
            exec switch_root /newroot /sbin/init
        fi
        umount /newroot 2>/dev/null
    fi
done
